---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import placeholders from '../assets/placeholders.json';

interface Props {
  name: string;
  alt: string;
  compact?: boolean;
  compactAt?: number;
  loading?: 'eager' | 'lazy';
  className?: string;
}
const { name, alt, compact = false, compactAt = 1000, loading = 'lazy', className = '' } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/product/*.webp', { eager: true });
const placeholderMap: Record<string, string> = placeholders;
const variants = await Promise.all((['light', 'dark'] as const).map(async (mode) => {
  const file = `${name}-${mode}.webp`;
  const image = images[`../assets/product/${file}`]?.default;
  if (!image) throw new Error(`Missing capture: ${file}`);
  const compactImage = compact ? images[`../assets/product/${name}-compact-${mode}.webp`]?.default : undefined;
  if (compact && !compactImage) throw new Error(`Missing compact capture: ${name}-${mode}`);
  const widths = (width: number) => [400, 800, 1200, 1600].filter((value) => value < width).concat(Math.min(width, 1600));
  const source = compactImage && await getImage({ src: compactImage, width: Math.min(compactImage.width, 1200), widths: widths(Math.min(compactImage.width, 1200)), format: 'webp', quality: 80 });
  return { mode, file, image, compactImage, source };
}));
---
<div class:list={['capture-pair', className]}>
  {variants.map(({ mode, file, image, compactImage, source }) => <picture class={`capture-${mode}`} aria-hidden={mode === 'dark' ? 'true' : undefined}>
    {source && compactImage && <source media={`(max-width: ${compactAt}px)`} width={compactImage.width} height={compactImage.height} srcset={source.srcSet.attribute} sizes="(max-width: 760px) calc(100vw - 80px), 50vw" />}
    <Image src={image} alt={mode === 'light' ? alt : ''} loading={loading} decoding="async" format="webp" quality={80} width={Math.min(image.width, 1600)} widths={[400, 800, 1200, 1600].filter((width) => width < image.width).concat(Math.min(image.width, 1600)).filter((width, index, all) => all.indexOf(width) === index)} sizes="(max-width: 760px) 90vw, 740px" style={`background-image:url('${placeholderMap[`product/${file}`]}');background-size:100% 100%`} />
  </picture>)}
</div>
