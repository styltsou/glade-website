<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Glade is a beautifully focused, local-first desktop notebook. Plain Markdown. Entirely yours." />
		<title>Glade — Local-first Markdown notebook</title>
		
		<script>
			import Lenis from 'lenis';

			const lenis = new Lenis({
				duration: 1.2,
				easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
			});

			function raf(time) {
				lenis.raf(time);
				requestAnimationFrame(raf);
			}

			requestAnimationFrame(raf);
		</script>
		
		<script is:inline>
			(function() {
				const stored = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (stored === 'dark' || (!stored && prefersDark)) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
	</head>
	<body class="bg-paper text-ink min-h-screen selection:bg-accent/20 selection:text-ink transition-colors duration-300 overflow-x-hidden">
		<slot />
	</body>
</html>

<style is:global>
	@import "../styles/global.css";

	:root {
		--theme-paper: #F0EEE7;
		--theme-surface: #F8F6F1;
		--theme-ink: #1D211B;
		--theme-accent: #A45439;
		--theme-muted: #716F67;
		--theme-line: #D5D1C6;
	}

	.dark {
		--theme-paper: #171A16;
		--theme-surface: #1F221D;
		--theme-ink: #EEECE4;
		--theme-accent: #C97858;
		--theme-muted: #929087;
		--theme-line: #30342D;
	}

	html, body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	html.lenis, html.lenis body {
		height: auto;
	}

	.lenis.lenis-smooth {
		scroll-behavior: auto;
	}
</style>
