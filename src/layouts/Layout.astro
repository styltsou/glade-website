<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="A minimal desktop note-taking app for developers and writers." />
		<title>Glade - Quiet space for loud minds</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />

		<script>
			import Lenis from 'lenis';

			const lenis = new Lenis({
				duration: 1.2,
				easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
			});

			function raf(time) {
				lenis.raf(time);
				requestAnimationFrame(raf);
			}

			requestAnimationFrame(raf);
		</script>
		
		<script is:inline>
			(function() {
				const stored = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (stored === 'dark' || (!stored && prefersDark)) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
	</head>
	<body class="bg-paper text-ink font-mono min-h-screen selection:bg-terracotta/20 selection:text-ink transition-colors duration-300">
		<slot />
	</body>
</html>

<style is:global>
	@import "../styles/global.css";

	:root {
		--theme-paper: #F4F2EC;
		--theme-surface: #FCFBF9;
		--theme-ink: #1C1B1A;
		--theme-terracotta: #A65D47;
		--theme-muted: #7A7671;
		--theme-line: #E2DFD8;
	}

	.dark {
		--theme-paper: #171615;
		--theme-surface: #1E1D1C;
		--theme-ink: #EAE7E0;
		--theme-terracotta: #C97A63;
		--theme-muted: #8A8680;
		--theme-line: #2E2C2A;
	}

	html, body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	html.lenis, html.lenis body {
		height: auto;
	}

	.lenis.lenis-smooth {
		scroll-behavior: auto;
	}
</style>
