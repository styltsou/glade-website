---
import '../styles/global.css';
const title = 'Glade — Read and edit your Markdown';
const description = 'A desktop Markdown editor that opens your folders in place. Split panes, a command palette, and edits that leave untouched text exactly as it was.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let theme = 'light';
        try { if (localStorage.getItem('glade-website-theme') === 'dark') theme = 'dark'; } catch {}
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const sync = () => document.querySelectorAll('[data-theme-toggle]').forEach(button => {
          const dark = root.classList.contains('dark');
          const label = dark ? 'Use light theme' : 'Use dark theme';
          button.setAttribute('aria-pressed', String(dark));
          button.setAttribute('aria-label', label);
          button.setAttribute('title', label);
        });
        document.addEventListener('click', event => {
          const button = event.target instanceof Element && event.target.closest('[data-theme-toggle]');
          if (!button) return;
          const theme = root.classList.contains('dark') ? 'light' : 'dark';
          root.classList.toggle('dark', theme === 'dark');
          try { localStorage.setItem('glade-website-theme', theme); } catch {}
          sync();
        });
        window.addEventListener('storage', event => {
          if (event.key !== 'glade-website-theme' && event.key !== null) return;
          root.classList.toggle('dark', event.newValue === 'dark');
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
