---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navigation -->
  <nav class="p-6 md:p-12 flex justify-between items-center">
    <div class="font-sans text-2xl tracking-tight">Glade.</div>
    <div class="flex items-center gap-6">
      <button id="theme-toggle" class="p-2 text-ink hover:text-terracotta transition-colors cursor-pointer" aria-label="Toggle dark mode">
        <svg id="sun-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="moon-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
      <div class="font-mono text-xs uppercase tracking-widest text-muted">v0.1.0</div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="px-6 md:px-12 pt-20 pb-32 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
      <div class="lg:col-span-8">
        <h1 class="hero-animate font-sans text-6xl md:text-8xl lg:text-[10rem] leading-[0.9] tracking-tight">
          Glade.
        </h1>
        <p class="hero-animate font-sans text-2xl md:text-3xl lg:text-4xl italic text-muted mt-6">
          Quiet space for loud minds.
        </p>
      </div>
      <div class="lg:col-span-4 pb-4">
        <div class="hero-animate flex flex-col items-start gap-8">
          <p class="font-mono text-sm leading-relaxed text-muted max-w-xs">
            A desktop note-taking app that keeps things simple. Your notes live on your machine as plain markdown files.
          </p>
          <a href="https://github.com/styltsou/glade" target="_blank" class="flex items-center gap-4 bg-ink text-paper px-6 py-4 hover:bg-terracotta transition-colors cursor-pointer duration-150">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span class="font-mono text-xs uppercase tracking-wider">View on GitHub</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- App Screenshot -->
  <section class="px-6 md:px-12 pt-16">
    <div class="mockup-container max-w-6xl mx-auto">
      <div class="mockup-animate bg-paper border border-line p-2 md:p-4 shadow-2xl shadow-ink/5">
        <img 
          src="/images/app-screenshot-light.png"
          alt="Glade app screenshot"
          class="w-full h-auto"
          id="app-screenshot"
        />
        <p class="font-mono text-sm text-muted text-center py-8" id="screenshot-fallback">
          Add screenshots to <code class="bg-line/50 px-1">public/images/app-screenshot-light.png</code> and <code class="bg-line/50 px-1">app-screenshot-dark.png</code>
        </p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-32 px-6 md:px-12 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-24 gap-y-32">
      
      <!-- Feature 1: Live Markdown -->
      <div class="feature-card flex flex-col gap-6">
        <div class="w-12 h-12 mb-2">
          <svg class="w-full h-full text-terracotta" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="6" y="10" width="36" height="28" rx="3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14 30V18l4 8 4-8v12" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M26 30V18l4 8 4-8v12" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="font-sans text-4xl md:text-5xl tracking-tight">Live Markdown.</h3>
        <p class="font-mono text-sm leading-relaxed text-muted">
          Write in plain text and see it come to life as you type. No flipping between modes, no messing with formats. Just write.
        </p>
      </div>

      <!-- Feature 2: Mermaid Diagrams -->
      <div class="feature-card flex flex-col gap-6 md:mt-32">
        <div class="w-12 h-12 mb-2">
          <svg class="w-full h-full text-terracotta" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="7" y="10" width="14" height="10" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="27" y="10" width="14" height="10" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="17" y="28" width="14" height="10" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14 20v4l7 4" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M34 20v4l-7 4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="font-sans text-4xl md:text-5xl tracking-tight">Mermaid Diagrams.</h3>
        <p class="font-mono text-sm leading-relaxed text-muted">
          Drop a code block with the mermaid language tag and watch your diagrams render live. Flowcharts, sequence diagrams, Gantt charts. All inside your notes. Pop out to full screen to zoom, pan, and export as PNG.
        </p>
      </div>

      <!-- Feature 3: Folders & Tags -->
      <div class="feature-card flex flex-col gap-6">
        <div class="w-12 h-12 mb-2">
          <svg class="w-full h-full text-terracotta" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 14h14l4 4h22v22H4V14z" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="font-sans text-4xl md:text-5xl tracking-tight">Folders & Tags.</h3>
        <p class="font-mono text-sm leading-relaxed text-muted">
          Organize your notes however you like. Deep folder hierarchies if you want structure, flexible tags if you prefer to let things breathe. Everything stays easy to find.
        </p>
      </div>

      <!-- Feature 4: Instant Search -->
      <div class="feature-card flex flex-col gap-6 md:mt-32">
        <div class="w-12 h-12 mb-2">
          <svg class="w-full h-full text-terracotta" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="22" cy="22" r="9" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M32 32l8 8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="font-sans text-4xl md:text-5xl tracking-tight">Instant Search.</h3>
        <p class="font-mono text-sm leading-relaxed text-muted">
          Type and find any note in a heartbeat. Powered by Rust, it respects your privacy. Your data never leaves your machine.
        </p>
      </div>

      <!-- Feature 5: Keyboard First -->
      <div class="feature-card flex flex-col gap-6">
        <div class="w-12 h-12 mb-2">
          <svg class="w-full h-full text-terracotta" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="6" y="16" width="36" height="20" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M10 22h4M10 28h4M16 22h4M16 28h4M22 22h4M22 28h4M28 22h4M28 28h4M34 22h4M34 28h4" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="18" y="30" width="12" height="2" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="font-sans text-4xl md:text-5xl tracking-tight">Keyboard First.</h3>
        <p class="font-mono text-sm leading-relaxed text-muted">
          Every action has a shortcut. Navigate, search, format, and manage your notes without leaving the keyboard. The command palette puts everything at your fingertips.
        </p>
      </div>

      <!-- Feature 6: Ambient Sounds -->
      <div class="feature-card flex flex-col gap-6 md:mt-32">
        <div class="w-12 h-12 mb-2">
          <svg class="w-full h-full text-terracotta" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M28 8l-12 8H8v16h8l12 8V8z" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M34 18c2 2 2 10 0 12" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M38 14c4 4 4 16 0 20" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="font-sans text-4xl md:text-5xl tracking-tight">Ambient Sounds.</h3>
        <p class="font-mono text-sm leading-relaxed text-muted">
          Rain, white noise, people sounds. Mix them together, dial in each volume, toggle everything from the status bar. A little background texture when you need it.
        </p>
      </div>

    </div>
  </section>

  <!-- Large Quote -->
  <section class="py-32 px-6 md:px-12 border-y border-line my-20">
    <div class="max-w-4xl mx-auto text-center">
      <div class="quote-animate font-sans text-3xl md:text-5xl leading-tight italic text-ink/80">
        "A tool should be invisible. It should get out of the way and let the work speak."
      </div>
    </div>
  </section>

  <!-- Footer CTA -->
  <footer class="py-32 px-6 md:px-12 text-center flex flex-col items-center gap-12">
    <div class="font-sans text-5xl md:text-7xl lg:text-8xl tracking-tight">Glade.</div>
    <a href="https://github.com/styltsou/glade" target="_blank" class="flex items-center gap-4 bg-transparent border border-ink text-ink px-8 py-4 hover:bg-ink hover:text-paper transition-colors cursor-pointer duration-150">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
      <span class="font-mono text-xs uppercase tracking-wider">View on GitHub</span>
    </a>
    <div class="font-mono text-base uppercase tracking-widest text-ink flex gap-8">
      <a href="https://x.com/styltsou" target="_blank" class="hover:text-terracotta transition-colors cursor-pointer">Twitter</a>
      <a href="https://github.com/styltsou/glade" target="_blank" class="hover:text-terracotta transition-colors cursor-pointer">GitHub</a>
    </div>
    <div class="font-mono text-sm text-muted">© Glade 2026 · Made by <a href="https://x.com/styltsou" target="_blank" class="hover:text-terracotta transition-colors cursor-pointer text-terracotta">@styltsou</a></div>
  </footer>
</Layout>

<script>
  import { animate, inView } from "motion";

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');

  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    sunIcon?.classList.toggle('hidden', !isDark);
    moonIcon?.classList.toggle('hidden', isDark);
  }

  themeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeIcons();
    updateScreenshot();
  });

  updateThemeIcons();

  // Theme-aware screenshot
  const screenshotImg = document.getElementById('app-screenshot') as HTMLImageElement;
  const screenshotFallback = document.getElementById('screenshot-fallback');

  function updateScreenshot() {
    if (!screenshotImg) return;
    const isDark = document.documentElement.classList.contains('dark');
    screenshotImg.src = isDark ? '/images/app-screenshot-dark.png' : '/images/app-screenshot-light.png';
  }

  if (screenshotImg && screenshotFallback) {
    screenshotImg.addEventListener('load', () => screenshotFallback.remove());
    screenshotImg.addEventListener('error', () => {
      screenshotImg.style.display = 'none';
      screenshotFallback.style.display = 'block';
    });
    if (screenshotImg.complete) {
      if (screenshotImg.naturalWidth > 0) screenshotFallback.remove();
    }
  }

  updateScreenshot();

  // Hero animations - run immediately on page load
  document.querySelectorAll('.hero-animate').forEach((el, index) => {
    const element = el as HTMLElement;
    animate(
      element,
      { opacity: [0, 1], y: [20, 0] },
      { duration: 0.5, delay: index * 0.1, easing: [0.2, 0.6, 0.3, 1] }
    );
  });

  // Mockup animation
  setTimeout(() => {
    const mockup = document.querySelector('.mockup-animate');
    if (mockup) {
      animate(
        mockup,
        { opacity: [0, 1], y: [40, 0] },
        { duration: 0.8, easing: [0.2, 0.6, 0.3, 1] }
      );
    }
  }, 400);

  // Feature cards scroll animation
  document.querySelectorAll('.feature-card').forEach((el, index) => {
    const element = el as HTMLElement;
    inView(element, () => {
      animate(
        element,
        { opacity: [0, 1], y: [30, 0] },
        { duration: 0.5, delay: index * 0.05, easing: [0.2, 0.6, 0.3, 1] }
      );
    }, { margin: "-100px" });
  });

  // Quote animation
  inView('.quote-animate', (element) => {
    animate(
      element,
      { opacity: [0, 1] },
      { duration: 0.8, easing: [0.2, 0.6, 0.3, 1] }
    );
  });

</script>
