---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq';
---

<Layout>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Glade home">Glade</a>

    <div class="header-actions">
      <button id="theme-toggle" class="icon-button" type="button" aria-label="Use dark theme" title="Toggle theme">
        <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A8.3 8.3 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8Z" /></svg>
        <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2.2M12 19.8V22M4.93 4.93 6.49 6.49M17.51 17.51l1.56 1.56M2 12h2.2M19.8 12H22M4.93 19.07l1.56-1.56M17.51 6.49l1.56-1.56" /></svg>
      </button>
      <a class="icon-button github-button" href="https://github.com/styltsou/glade" target="_blank" rel="noreferrer" aria-label="View Glade on GitHub" title="View on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 1.7a10.3 10.3 0 0 0-3.26 20.07c.52.1.7-.22.7-.5v-1.8c-2.84.62-3.44-1.2-3.44-1.2-.47-1.17-1.14-1.48-1.14-1.48-.93-.63.07-.62.07-.62 1.03.07 1.57 1.05 1.57 1.05.92 1.57 2.4 1.12 2.98.86.09-.66.36-1.12.66-1.38-2.27-.26-4.66-1.13-4.66-5.03 0-1.11.4-2.02 1.05-2.73-.1-.26-.46-1.3.1-2.7 0 0 .86-.28 2.82 1.04a9.8 9.8 0 0 1 5.13 0c1.96-1.32 2.82-1.04 2.82-1.04.56 1.4.21 2.44.1 2.7.65.71 1.05 1.62 1.05 2.73 0 3.91-2.4 4.76-4.68 5.02.37.32.7.93.7 1.88v2.79c0 .28.18.61.71.5A10.3 10.3 0 0 0 12 1.7Z"/></svg>
      </a>
      <a class="header-cta" id="header-cta" href="https://github.com/styltsou/glade" target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="m7 10 5 5 5-5" /><path d="M12 15V3" /></svg>
        <span class="download-label">Get Glade</span>
      </a>
    </div>
  </header>

  <main id="top">
    <section class="hero shell" aria-labelledby="hero-title">
      <h1 id="hero-title">A local-first<br />Markdown notebook.</h1>
      <div class="hero-actions" aria-label="Get Glade">
        <a class="button button-primary" id="hero-cta" href="https://github.com/styltsou/glade" target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="m7 10 5 5 5-5" /><path d="M12 15V3" /></svg>
          <span class="download-label">Get Glade</span>
        </a>
        <a class="button button-secondary" href="#features">Learn more</a>
      </div>
    </section>

    <section class="visual-stage shell" aria-label="Glade app preview">
      <div class="painting-wrap">
        <img
          src="/images/glade-painting.webp"
          alt="A quiet woodland glade at first light"
          class="painting"
          width="1536"
          height="1024"
        />
        <div class="app-window">
          <img
            src="/images/app-screenshot-light.png"
            alt="Glade showing a Markdown note with folders, a diagram, and document outline"
            id="app-screenshot"
            width="1623"
            height="1101"
          />
        </div>
      </div>
    </section>

    <section id="features" class="features shell" aria-labelledby="features-title">
      <h2 id="features-title">Everything you need.<br />Nothing in the way.</h2>

      <div class="bento-grid">
        <article class="bento-card bento-note">
          <div class="bento-copy">
            <h3>A note for everything.</h3>
            <p>Write in plain Markdown and keep every file on your machine.</p>
          </div>
          <div class="card-screen card-screen-main" aria-hidden="true">
            <img src="/images/app-screenshot-light.png" alt="" />
          </div>
        </article>

        <article class="bento-card bento-organize">
          <div class="bento-copy">
            <h3>Structure that stays light.</h3>
            <p>Folders and tags when you need them.</p>
          </div>
          <div class="card-screen card-screen-sidebar" aria-hidden="true">
            <img src="/images/app-screenshot-light.png" alt="" />
          </div>
        </article>

        <article class="bento-card bento-diagrams">
          <div class="bento-copy">
            <h3>See the whole thought.</h3>
            <p>Turn Mermaid into diagrams, right in your notes.</p>
          </div>
          <div class="card-screen card-screen-diagram" aria-hidden="true">
            <img src="/images/app-screenshot-light.png" alt="" />
          </div>
        </article>
      </div>
    </section>

    <section class="faq shell" aria-labelledby="faq-title">
      <h2 id="faq-title">FAQ</h2>
      <Faq client:load />
    </section>

    <section class="download-section shell" aria-labelledby="download-title">
      <h2 id="download-title">Try Glade now.</h2>
      <a id="download-cta" class="download-button" href="https://github.com/styltsou/glade" target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="m7 10 5 5 5-5" /><path d="M12 15V3" /></svg>
        <span class="download-label">Download Glade</span>
      </a>
    </section>
  </main>

  <footer class="site-footer shell">
    <span>© 2026 Glade</span>
    <span>Made by <a href="https://styltsou.com" target="_blank" rel="noreferrer">styltsou</a></span>
  </footer>
</Layout>

<script>
  const root = document.documentElement;
  const themeToggle = document.getElementById('theme-toggle');
  const screenshot = document.getElementById('app-screenshot') as HTMLImageElement | null;
  const downloadCta = document.getElementById('download-cta');

  const syncTheme = () => {
    const isDark = root.classList.contains('dark');
    themeToggle?.setAttribute('aria-label', isDark ? 'Use light theme' : 'Use dark theme');
    if (!screenshot) return;
    screenshot.src = isDark
      ? '/images/app-screenshot-dark.png'
      : '/images/app-screenshot-light.png';
  };

  themeToggle?.addEventListener('click', () => {
    root.classList.toggle('dark');
    localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
    syncTheme();
  });

  syncTheme();

  const platform = navigator.userAgentData?.platform || navigator.platform || navigator.userAgent;
  const operatingSystem = /mac/i.test(platform)
    ? 'macOS'
    : /win/i.test(platform)
      ? 'Windows'
      : /linux/i.test(platform)
        ? 'Linux'
        : 'your device';

  const headerCta = document.getElementById('header-cta');
  const heroCta = document.getElementById('hero-cta');
  for (const el of [headerCta, heroCta, downloadCta]) {
    const label = el?.querySelector('.download-label');
    if (label) label.textContent = `Download for ${operatingSystem}`;
  }

</script>
