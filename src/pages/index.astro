---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq';
import Brand from '../components/Brand.astro';
import { Features, HowItWorks } from '../components/ProductDetails';
import MobilePreview from '../components/MobilePreview.astro';
import ExternalLink from '../components/ExternalLink.astro';
import AppCapture from '../components/AppCapture';
const repo = 'https://github.com/styltsou/glade';
const setup = `${repo}#getting-started`;
const releases = `${repo}/releases/latest`;
const installCmd = 'curl -fsSL https://raw.githubusercontent.com/styltsou/glade/main/scripts/install.sh | sh';
---
<Layout>
  <header class="site-header">
    <div class="header-inner shell">
    <a class="wordmark" href="#top" aria-label="Glade home"><Brand />Glade</a>
    <nav aria-label="Main navigation"><a href="#features">Features</a><a href="#how-it-works">How it works</a><a href="#questions">Questions</a></nav>
    <div class="header-actions">
      <a class="button button-primary header-download" data-download data-download-compact href={releases}>Download</a>
      <a class="header-github" href={repo}>GitHub <ExternalLink /></a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Use dark theme" aria-pressed="false" title="Use dark theme">
        <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A8.3 8.3 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8Z" /></svg>
        <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </div>
    </div>
  </header>
  <main id="main">
    <section id="top" class="hero shell">
      <h1>Read and edit<br />your Markdown.</h1>
      <div class="hero-aside"><p>Open a folder of notes. Switch between rich text and Markdown.</p><a class="button button-primary" data-download href={releases}>Download for Windows or Linux <ExternalLink /></a><span class="hero-note" data-download-note>Windows and Linux. Open source, MIT licensed.</span></div>
    </section>

    <section id="the-app" class="product-section shell" aria-label="Glade app preview">
      <div class="painting-wrap">
        <img class="painting painting-light" src="/images/glade-spring.webp" alt="" width="1536" height="1024" />
        <img class="painting painting-dark" src="/images/glade-autumn.webp" alt="" width="1536" height="1024" />
        <div class="app-window">
          <MobilePreview />
          <div class="desktop-preview"><AppCapture name="app-hero" alt="Glade's current interface: a Markdown folder, compact file tabs, and two independent editor panes." loading="eager" /></div>
        </div>
      </div>
    </section>

    <section id="features" class="details-section shell" aria-label="What Glade does">
      <h2 class="sr-only">What Glade does</h2>
      <Features />
    </section>

    <section id="how-it-works" class="details-section shell" aria-labelledby="how-title">
      <HowItWorks />
    </section>

    <section id="questions" class="faq-section shell" aria-labelledby="faq-title"><div class="faq-heading"><h2 id="faq-title">Questions</h2></div><Faq /></section>

    <section id="get-glade" class="get-section shell" aria-labelledby="get-title"><div class="get-panel"><Brand /><h2 id="get-title">Try Glade.</h2><p>Download it, then point it at a folder of notes.</p><div class="hero-actions"><a class="button button-primary" data-download href={releases}>Download for Windows or Linux <ExternalLink /></a><a class="button button-secondary" href={setup}>Build from source <ExternalLink /></a></div><div class="install-cmd" data-install hidden><code tabindex="0" aria-label="Linux install command">{installCmd}</code><button type="button" data-copy={installCmd}>Copy</button></div><p class="availability" data-download-note>Windows installer and Linux AppImage. Windows will show an unknown publisher warning: choose More info, then Run anyway.</p></div></section>
  </main>
  <footer class="site-footer shell"><a class="wordmark" href="#top"><Brand />Glade</a><span>© {new Date().getFullYear()} Glade</span><div><a href={repo}>GitHub <ExternalLink /></a><a href={`${repo}#license`}>MIT license</a><a href="https://styltsou.com">Made by styltsou</a></div></footer>
</Layout>
<script>
  import '../scripts/faq';
  import '../scripts/scroll';
  import '../scripts/how-story';
  const ua = navigator.userAgent;
  const os = /Windows/i.test(ua) ? 'windows' : /Android|iPhone|iPad/i.test(ua) ? 'other' : /Linux|X11/i.test(ua) ? 'linux' : /Mac/i.test(ua) ? 'mac' : 'other';
  const labels: Record<string, string> = { windows: 'Windows', linux: 'Linux' };
  const buttons = document.querySelectorAll<HTMLAnchorElement>('[data-download]');
  const notes = document.querySelectorAll<HTMLElement>('[data-download-note]');
  if (labels[os]) buttons.forEach((a) => { if (a.firstChild && !a.hasAttribute('data-download-compact')) a.firstChild.textContent = `Download for ${labels[os]} `; });
  if (os === 'linux') document.querySelectorAll<HTMLElement>('[data-install]').forEach((el) => (el.hidden = false));
  if (os === 'mac') {
    notes.forEach((el) => (el.hidden = true));
    buttons.forEach((a) => {
      a.href = 'https://github.com/styltsou/glade/issues/new?title=macOS+build+request';
      if (a.firstChild) a.firstChild.textContent = a.hasAttribute('data-download-compact') ? 'Request macOS' : 'Request the macOS version ';
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy'), 1500); } catch {}
    })
  );
  if (labels[os]) {
    fetch('https://api.github.com/repos/styltsou/glade/releases/latest')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((rel: { tag_name: string; assets: { name: string; browser_download_url: string }[] }) => {
        const match = os === 'windows' ? /-setup\.exe$/i : /\.AppImage$/i;
        const asset = rel.assets.find((a) => match.test(a.name));
        if (!asset) return;
        buttons.forEach((a) => {
          if (os === 'windows') a.href = asset.browser_download_url;
        });
      })
      .catch(() => {});
  }
</script>
